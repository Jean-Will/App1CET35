<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".activity_tela3">

    <TextView
        android:id="@+id/tvNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="40sp"
        android:layout_marginTop="20dp"
        android:textColor="@color/white"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESCOLHA PIZZA"
        android:gravity="center"
        android:textSize="40sp"

        android:textColor="@color/white"
        />



    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal"
        android:scrollbarSize="20dp"
        android:layout_marginTop="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="200dp"
                android:src="@drawable/pizza1"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="20dp"
                android:id="@+id/imgPizza1" />

            <ImageView
                android:layout_width="150dp"
                android:layout_height="200dp"
                android:src="@drawable/pizza2"
                android:layout_marginRight="20dp"
                android:id="@+id/imgPizza2" />

            <ImageView
                android:layout_width="150dp"
                android:layout_height="200dp"
                android:src="@drawable/pizza3"
                android:layout_marginRight="20dp"
                android:id="@+id/imgPizza3" />

        </LinearLayout>

    </HorizontalScrollView>



    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal"
        android:scrollbarSize="20dp"
        android:layout_marginTop="45dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="200dp"
                android:src="@drawable/pizza1"
                android:layout_marginRight="30dp"
                android:id="@+id/imgPizza4" />

            <ImageView
                android:layout_width="150dp"
                android:layout_height="200dp"
                android:src="@drawable/pizza2"
                android:layout_marginRight="30dp"
                android:id="@+id/imgPizza5" />

            <ImageView
                android:layout_width="150dp"
                android:layout_height="200dp"
                android:src="@drawable/pizza3"
                android:layout_marginRight="10dp"
                android:id="@+id/imgPizza6" />

        </LinearLayout>



    </HorizontalScrollView>



    <TextView
        android:id="@+id/tvEscolha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:text="Pizza Escolhida"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:textColor="@color/white"
        android:gravity="center"
        />


</LinearLayout>